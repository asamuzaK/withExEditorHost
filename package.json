  "license": "MIT",
  "homepage": "https://github.com/asamuzaK/withExEditorHost",
  "bugs": "https://github.com/asamuzaK/withExEditorHost/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asamuzaK/withExEditorHost.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.1",
    "commander": "^15.0.0",
    "semver-parser": "^4.2.1",
    "undici": "^8.10.2",
    "web-ext-native-msg": "^9.0.4"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.5",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "genversion": "^3.2.0",
    "globals": "^17.12.0",
    "mocha": "^12.0.0",
    "neostandard": "^0.14.0-next.1",
    "sinon": "^22.1.0"
  },
  "scripts": {
    "build": "npm run genversion && npm run lint && npm run test",
    "genversion": "genversion --es6 --semi ./modules/version.js",
    "lint": "eslint . --fix",
    "setup": "node ./index.js setup",
