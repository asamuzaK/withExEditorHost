{
  "name": "withexeditorhost",
  "description": "Native messaging host for withExEditor",
  "author": "asamuzaK",
  "license": "MIT",
  "homepage": "https://github.com/asamuzaK/withExEditorHost",
  "bugs": "https://github.com/asamuzaK/withExEditorHost/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asamuzaK/withExEditorHost.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "commander": "^15.0.0",
    "semver-parser": "^4.2.2",
    "undici": "^8.12.3",
    "web-ext-native-msg": "^9.0.6"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-regexp": "^3.3.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "genversion": "^3.2.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "neostandard": "^0.14.1",
    "prettier": "^3.9.10",
    "prettier-plugin-brace-style": "^0.10.4",
    "sinon": "^22.1.0"
  },
  "scripts": {
    "build": "npm run genversion && npm run lint && npm run test",
    "genversion": "genversion --es6 --semi ./modules/version.js",
