{
  "name": "withexeditorhost",
  "description": "Native messaging host for withExEditor",
  "author": "asamuzaK",
  "license": "MIT",
  "homepage": "https://github.com/asamuzaK/withExEditorHost",
  "bugs": "https://github.com/asamuzaK/withExEditorHost/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asamuzaK/withExEditorHost.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^15.0.0",
    "semver-parser": "^4.2.1",
    "undici": "^8.10.0",
    "web-ext-native-msg": "^9.0.4"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "genversion": "^3.2.0",
    "globals": "^17.11.0",
    "mocha": "^11.8.0",
    "neostandard": "^0.14.0-next",
    "sinon": "^22.1.0"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.4",
      "js-yaml": "^4.3.1",
      "serialize-javascript": "^7.0.5"
    }
  },
  "scripts": {
    "build": "npm run genversion && npm run lint && npm run test",
    "genversion": "genversion --es6 --semi ./modules/version.js",
    "lint": "eslint . --fix",
    "setup": "node ./index.js setup",
    "start": "node ./index.js",
    "test": "c8 --reporter=text mocha --exit test/*.test.js"
  },
  "version": "10.0.2"
}
